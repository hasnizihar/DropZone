{
  "name": "@dropzone/desktop",
  "version": "1.0.0-alpha.12",
  "description": "Universal Desktop Download Manager",
  "author": "Hz Creatives (KR Hasni Zihar)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hasnizihar/dropzone.git"
  },
  "private": true,
  "main": "./dist/main/index.cjs",
  "scripts": {
    "dev": "concurrently -k -s first \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && npm run build:electron && cross-env NODE_ENV=development electron .",
    "build": "npm run build:electron && vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package:win": "electron-builder --win nsis --config electron-builder.yml",
    "package:portable": "electron-builder --win portable --config electron-builder.yml",
    "package:all": "electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "@dropzone/shared": "*",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.16.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "34.5.8",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7",
    "wait-on": "^8.0.3"
  }
}
