{
  "name": "dropzone-root",
  "version": "1.0.0-alpha.12",
  "description": "Universal Desktop Download Manager",
  "author": "Hz Creatives (KR Hasni Zihar)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hasnizihar/dropzone.git"
  },
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "website"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@dropzone/desktop",
    "website:dev": "npm run dev --workspace=@dropzone/website",
    "website:build": "npm run build --workspace=@dropzone/website",
    "website:preview": "npm run preview --workspace=@dropzone/website",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:python": "python -m pytest backend/worker/tests -v",
    "test:platforms": "python scripts/test-platform-matrix.py",
    "test:downloads": "python -u scripts/test-real-downloads.py",
    "postinstall": "node scripts/patch-electron-builder.cjs",
    "build:worker": "python scripts/build-worker.py",
    "build:icons": "python scripts/generate-icons.py",
    "package:inno": "powershell -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "verify:installer": "powershell -ExecutionPolicy Bypass -File scripts/verify-installer.ps1",
    "package:win": "node scripts/patch-electron-builder.cjs && npm run build && electron-builder --win nsis --project apps/desktop --config electron-builder.yml",
    "package:portable": "node scripts/patch-electron-builder.cjs && npm run build && electron-builder --win portable --project apps/desktop --config electron-builder.yml",
    "package:all": "node scripts/patch-electron-builder.cjs && npm run build && electron-builder --win --project apps/desktop --config electron-builder.yml",
    "smoke:electron": "node scripts/smoke-test.cjs",
    "smoke:packaged": "node scripts/smoke-test-packaged.cjs"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.68.2"
  },
  "devDependencies": {
    "@rollup/wasm-node": "^4.68.2"
  }
}
